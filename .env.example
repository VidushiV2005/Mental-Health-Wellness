# No database URL: persistent local SQLite in ./data/wellness.sqlite
# For PostgreSQL with pgvector, start docker compose and uncomment:
# DATABASE_URL=postgresql://wellness:local-wellness@localhost:5432/wellness
APP_ORIGIN=http://localhost:3000
# Keep API keys on the server; never prefix them with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Local MiniLM embeddings are free. First use downloads a public model.
# Run npm run embeddings:prepare before enabling semantic mode.
EMBEDDING_MODE=lexical
# EMBEDDING_MODE=semantic
# Set to true only behind HTTPS in production.
COOKIE_SECURE=false
