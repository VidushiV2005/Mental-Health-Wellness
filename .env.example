# No database URL: persistent local SQLite in ./data/wellness.sqlite
# For PostgreSQL with pgvector, start docker compose and uncomment:
# DATABASE_URL=postgresql://wellness:local-wellness@localhost:5432/wellness
APP_ORIGIN=http://localhost:3000
# Keep API keys on the server; never prefix them with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Priority: OpenRouter first, Gemini if it fails or is not configured.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Legacy embedding utilities only. Journal saves no longer run embedding inference.
# Active journal analysis uses the separate consent-gated server worker.
EMBEDDING_MODE=lexical
# EMBEDDING_MODE=semantic
# Set to true only behind HTTPS in production.
COOKIE_SECURE=false
