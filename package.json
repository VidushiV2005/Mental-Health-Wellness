{
  "name": "mental-health-wellness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib scripts tests docs README.md next.config.ts package.json tsconfig.json docker-compose.yml",
    "format:check": "prettier --check app components lib scripts tests docs README.md next.config.ts package.json tsconfig.json docker-compose.yml",
    "test": "tsx --test tests/*.test.ts",
    "db:check": "tsx scripts/check-db.ts",
    "ai:check": "tsx scripts/check-ai.ts",
    "journals:import": "tsx scripts/import-journals.ts",
    "embeddings:prepare": "tsx scripts/prepare-embeddings.ts",
    "worker": "tsx scripts/journal-worker.ts",
    "worker:once": "tsx scripts/journal-worker.ts --once"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
